# ── Wazzup WhatsApp Gateway (optional) ────────────────────────────────────────
WAZZUP_ENABLED=false
WAZZUP_API_KEY=
WAZZUP_CHANNEL_ID=
WAZZUP_WEBHOOK_PORT=8080
WAZZUP_WEBHOOK_PATH=/wazzup/webhook
# REQUIRED in production. Generate with: openssl rand -hex 32
# Configure the same secret in the Wazzup admin panel as a custom
# `Authorization: Bearer <secret>` header on the webhook, or append
# `?token=<secret>` to the webhook URL.
WAZZUP_WEBHOOK_SECRET=
VIDEO_BASE_URL=
ARTICLES_BASE_URL=

# ── Paths (state vs static media) ─────────────────────────────────────────────
# STATE_DIR — writable runtime state (SQLite DB, ChromaDB index, logs,
# escalations, telegraph + video file_id caches). On Railway: set to
# /app/state and mount the persistent volume there. On local docker: ./data.
# STATE_DIR=/app/state
#
# VIDEOS_DIR — image-baked static videos. On Railway: /app/media-videos (set
# automatically by the Dockerfile, no need to override). On local docker:
# data/videos.
# VIDEOS_DIR=/app/media-videos

# ── Database ──────────────────────────────────────────────────────────────────
# Default = SQLite under ./data/bot.db. Fine up to roughly ~50 concurrent
# WhatsApp chats (WAL mode + busy_timeout=5s are auto-enabled). Past that,
# the single-writer lock on SQLite becomes the bottleneck and you'll start
# seeing "database is locked" warnings under bursts.
#
# Also: on hosts with an ephemeral filesystem (Heroku, Render free, Fly.io
# without volumes) the SQLite file is WIPED on every restart. For prod —
# use Postgres:
#   DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/dbname
# Free Postgres tiers: Neon, Supabase, Railway, Aiven. The schema and the
# idle-reminder index are created automatically on first startup.
# DATABASE_URL=sqlite+aiosqlite:///./data/bot.db

# ── Backpressure / concurrency knobs ──────────────────────────────────────────
# Cap on simultaneous LLM round-trips. With N concurrent WhatsApp chats,
# only this many will be talking to OpenAI/Anthropic at once; the rest
# queue on an asyncio semaphore. This prevents 429 cascades and bounds
# memory held by in-flight responses. Tune up on paid tiers, down on free.
# LLM_MAX_CONCURRENT=20
# Hard ceiling on one LLM round-trip (seconds). Hung provider → killed.
# LLM_REQUEST_TIMEOUT=90
# Retries on rate-limit/5xx with exponential backoff.
# LLM_MAX_RETRIES=2
# Cap on parallel SentenceTransformer encode() calls (RAG embeddings).
# The model is a single in-process instance — too many parallel encodes
# saturate CPU. 2-4 on a 1-vCPU host, 8 on a beefy one.
# RAG_MAX_CONCURRENT=4
# Maximum incoming webhook body size in bytes.
# WEBHOOK_MAX_BODY_SIZE=1048576

# ── Optional overrides (defaults shown) ───────────────────────────────────────
# MODEL_NAME=gpt-4o-mini
